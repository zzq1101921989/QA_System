// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id         String    @id
  title      String?
  documentId String?
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Message {
  id              String   @id @default(uuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String   // 'user' | 'assistant'
  content         String
  readDocumentIds String   @default("")
  createdAt       DateTime @default(now())
}

model Document {
  id         String   @id @default(uuid())
  name       String?
  status     String   @default("processing") // 文档状态: processing, ready, error
  chunkCount Int      @default(0)
  page_count Int      @default(0)
  summary    String?
  keywords   String?  // 存储为 JSON 字符串
  outline    String?  // 存储为 JSON 字符串
  elements   String?  // 解析后的元素组合数组，含 pageNumber、bbox 等位置信息（JSON 字符串）
  filePath   String?  // 原始文件路径
  mimeType   String?  // 文件 MIME 类型
  documentId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
